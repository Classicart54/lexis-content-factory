TELEGRAM_BOT_TOKEN=
DATA_DIR=./data
# Optional comma-separated Telegram user ids. Empty means everyone can use the bot.
ALLOWED_TELEGRAM_USER_IDS=

# Optional. If set, the search/facts agent uses Neuromedia GPT API with web_search.
NEUROMEDIA_API_KEY=
NEUROMEDIA_BASE_URL=https://app.neuromedia.cloud/v1
NEUROMEDIA_MODEL=gpt-5.6-terra
NEUROMEDIA_TIMEOUT_MS=120000

# Optional path to the generated handoff folder with fakty/*.json.
HANDOFF_KONVEYER_DIR=/path/to/lexis_voice/landing/handoff-konveyer

# Optional. If set, approved guide materials are published to Lexis site.
CONTENT_API_URL=http://127.0.0.1:3000/api/content
CONTENT_API_TOKEN=

# 1 for the legacy landing renderer; 2 for guide-v2 (example/takeaways/expert).
CONTENT_SCHEMA_VERSION=1
